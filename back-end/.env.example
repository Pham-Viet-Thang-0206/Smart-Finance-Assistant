PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=monee_db
DB_SSL=false

# Optional: used for AI transaction classification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: only required if you want speech-to-text.
# Windows: you can also set this as a system env var instead of .env.
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\google-speech-key.json
